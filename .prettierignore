# Generated or vendored output: checked out by tooling, never edited by hand.
.next/
storybook-static/
node_modules/
coverage/
playwright-report/
test-results/

# Screenshots are binary comparisons, not formatted text.
tests/visual/__snapshots__/

# The lockfile is npm's to write; a formatter run would only churn it.
package-lock.json

# Icons and other generated assets.
public/

# Generated SDK bindings, checked in by the contracts repo, not edited here.
vendor/

# Shell hooks, no Prettier parser (and they are not code this repo formats).
.husky/

# Workflow files are edited by hand. GitHub refuses any push that touches a
# workflow file unless the pushing token has the `workflow` scope, so running
# Prettier over them would make the repository harder to contribute to than the
# formatting is worth; reviewers read them as YAML anyway.
.github/workflows/
