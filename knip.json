{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,loading,error,not-found,opengraph-image,icon}.{ts,tsx}",
    "scripts/*.mjs",
    "tests/**/*.spec.ts",
    ".storybook/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.ts",
    ".storybook/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreIssues": {
    "src/lib/contracts/generated/**": ["exports", "types"]
  },
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
